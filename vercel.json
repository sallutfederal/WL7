{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": "gateway",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "setup": {
      "root": "setup",
      "framework": "express",
      "entrypoint": "index.js",
      "bindings": [
        {
          "type": "service",
          "service": "gateway",
          "format": "url",
          "env": "GATEWAY_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/webhook/pingocash",
      "destination": { "service": "gateway" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "setup" }
    }
  ]
}
